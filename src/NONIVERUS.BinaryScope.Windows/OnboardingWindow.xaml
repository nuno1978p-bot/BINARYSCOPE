<Window x:Class="NONIVERUS.BinaryScope.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="NONIVERUS BinaryScope"
        MinHeight="760" MinWidth="1080"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource NavyBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="34">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="38">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <Image Source="Assets/BinaryScope_mark_color_1024.png"
                           Width="210" Height="210"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"/>
                    <TextBlock Text="NONIVERUS" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,0"/>
                    <TextBlock FontSize="42" FontWeight="Bold" Margin="0,5,0,0">
                        <Run Text="Binary"/><Run Text="Scope" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Android App Bundle Release Analyzer"
                               FontSize="17"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Inspect. Compare. Release with evidence."
                               FontSize="20"
                               Margin="0,30,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LOCAL-FIRST" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="LocalNoteText"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="46">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="StepText"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="12"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TitleText"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="BodyText"
                               FontSize="17"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,18,0,0"
                               MaxWidth="760"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               LineHeight="27"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,32,0,32">
                    <StackPanel x:Name="SelectionPanel"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="LanguageLabelText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="LanguageCombo"
                                  Width="430"
                                  HorizontalAlignment="Left"
                                  Padding="12,8"
                                  ItemsSource="{x:Null}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectionChanged="LanguageCombo_SelectionChanged"/>

                        <TextBlock x:Name="ThemeLabelText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,26,0,8"/>
                        <ComboBox x:Name="ThemeCombo"
                                  Width="430"
                                  HorizontalAlignment="Left"
                                  Padding="12,8"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Key"
                                  SelectionChanged="ThemeCombo_SelectionChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                            <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="9" Padding="13,8" Margin="0,0,10,0">
                                <TextBlock Text="Midnight"/>
                            </Border>
                            <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="9" Padding="13,8" Margin="0,0,10,0">
                                <TextBlock Text="Graphite"/>
                            </Border>
                            <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="9" Padding="13,8">
                                <TextBlock Text="Light Precision"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ReadyPanel"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Border Background="{DynamicResource ElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="48" Height="48" Fill="{DynamicResource PassBrush}"/>
                                <TextBlock Grid.Column="0"
                                           Text="✓"
                                           Foreground="#07111F"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="PASS / REVIEW / REGRESSION"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ReadyEvidenceText"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot0" Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource AccentBrush}"/>
                        <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource BorderBrush}"/>
                        <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource BorderBrush}"/>
                        <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource BorderBrush}"/>
                        <Ellipse x:Name="Dot4" Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource BorderBrush}"/>
                        <Ellipse x:Name="Dot5" Width="8" Height="8" Fill="{DynamicResource BorderBrush}"/>
                    </StackPanel>

                    <Button x:Name="BackButton"
                            Grid.Column="1"
                            Style="{StaticResource ProductSecondaryButtonStyle}"
                            Click="Back_Click"/>
                    <Button x:Name="NextButton"
                            Grid.Column="3"
                            Style="{StaticResource ProductPrimaryButtonStyle}"
                            MinWidth="180"
                            Click="Next_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
