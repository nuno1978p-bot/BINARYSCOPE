<Window x:Class="NONIVERUS.BinaryScope.Windows.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NONIVERUS BinaryScope — AAB Compare"
        Height="900" Width="1440"
        MinHeight="760" MinWidth="1120"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        StateChanged="Window_StateChanged"
        Background="{StaticResource NavyBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="CompareHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#1B2A43"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#344662"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="CompareButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Background" Value="#17243B"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2A3A56"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AAB Compare" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Read-only build-to-build evidence · AFTER minus BEFORE"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export comparison JSON" Click="ExportJson_Click" Style="{StaticResource CompareButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Export comparison TXT" Click="ExportText_Click" Style="{StaticResource CompareButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="BEFORE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BeforeNameText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="BeforeShaText" Text="—" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="→" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="AFTER" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AfterNameText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AfterShaText" Text="—" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="REGRESSION GATE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GateVerdictText" Text="UNPROVEN" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock x:Name="GatePolicyText" Text="Internal thresholds" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Findings" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GateFindingsText" Text="none" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Improvement signals" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GateImprovementsText" Text="none" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.9*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="1.1*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Metric deltas" FontSize="19" FontWeight="SemiBold"/>
                        <DataGrid Grid.Row="2" x:Name="MetricsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Background="#0D1728"
                                  Foreground="White"
                                  RowBackground="#0D1728"
                                  AlternatingRowBackground="#13213A"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  ColumnHeaderStyle="{StaticResource CompareHeaderStyle}"
                                  RowHeight="30"
                                  ColumnHeaderHeight="35">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="*"/>
                                <DataGridTextColumn Header="Before" Binding="{Binding BeforeValue, StringFormat={}{0:N0}}" Width="105"/>
                                <DataGridTextColumn Header="After" Binding="{Binding AfterValue, StringFormat={}{0:N0}}" Width="105"/>
                                <DataGridTextColumn Header="Delta" Binding="{Binding Delta, StringFormat={}{0:N0}}" Width="105"/>
                                <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="ABI / category changes" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AbiDeltaText" Text="No ABI changes." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,12"/>
                        <DataGrid x:Name="CategoryGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Background="#0D1728"
                                  Foreground="White"
                                  RowBackground="#0D1728"
                                  AlternatingRowBackground="#13213A"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  ColumnHeaderStyle="{StaticResource CompareHeaderStyle}"
                                  Height="265"
                                  RowHeight="30"
                                  ColumnHeaderHeight="35">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Raw delta" Binding="{Binding DeltaRawBytes, StringFormat={}{0:N0}}" Width="115"/>
                                <DataGridTextColumn Header="Compressed" Binding="{Binding DeltaCompressedBytes, StringFormat={}{0:N0}}" Width="115"/>
                                <DataGridTextColumn Header="Contrib." Binding="{Binding DeltaContributorCount, StringFormat={}{0:N0}}" Width="75"/>
                                <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="DependencyGraphText"
                                   Text="UNPROVEN FROM AAB ALONE"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Binary contributor changes" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" x:Name="ContributorSummaryText"
                               Text="Only ADDED / REMOVED / CHANGED contributors are listed."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                    <DataGrid Grid.Row="4" x:Name="ContributorChangesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="#0D1728"
                              Foreground="White"
                              RowBackground="#0D1728"
                              AlternatingRowBackground="#13213A"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource CompareHeaderStyle}"
                              RowHeight="30"
                              ColumnHeaderHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Contributor" Binding="{Binding ContributorName}" Width="1.55*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.1*"/>
                            <DataGridTextColumn Header="Before raw" Binding="{Binding BeforeRawBytes, StringFormat={}{0:N0}}" Width="105"/>
                            <DataGridTextColumn Header="After raw" Binding="{Binding AfterRawBytes, StringFormat={}{0:N0}}" Width="105"/>
                            <DataGridTextColumn Header="Raw delta" Binding="{Binding DeltaRawBytes, StringFormat={}{0:N0}}" Width="105"/>
                            <DataGridTextColumn Header="ABI before" Binding="{Binding BeforeAbiCount}" Width="78"/>
                            <DataGridTextColumn Header="ABI after" Binding="{Binding AfterAbiCount}" Width="74"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="88"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
