<Application x:Class="NONIVERUS.BinaryScope.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#07111F"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#0E1A2B"/>
        <SolidColorBrush x:Key="ElevatedBrush" Color="#17243B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3A56"/>
        <SolidColorBrush x:Key="GridBrush" Color="#0D1728"/>
        <SolidColorBrush x:Key="GridAlternateBrush" Color="#13213A"/>
        <SolidColorBrush x:Key="GridHeaderBrush" Color="#1B2A43"/>
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#263650"/>
        <SolidColorBrush x:Key="ReviewSurfaceBrush" Color="#251D14"/>
        <SolidColorBrush x:Key="ReviewBorderBrush" Color="#8F5C28"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#FF7A1A"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#101010"/>
        <SolidColorBrush x:Key="PassBrush" Color="#40D98A"/>
        <SolidColorBrush x:Key="ReviewBrush" Color="#FFB547"/>
        <SolidColorBrush x:Key="RegressionBrush" Color="#FF5C6C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <Style x:Key="ProductPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ProductSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
